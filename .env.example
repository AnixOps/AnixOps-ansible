# =============================================================================
# AnixOps Ansible — environment variables | 环境变量示例
# =============================================================================
# Copy to .env and fill in real values (the .env file is git-ignored):
#   cp .env.example .env
#   set -a; source .env; set +a        # or: bash scripts/anixops.sh <command>
#
# Every variable below is read by the inventory (inventories/production/hosts.yml,
# generated from servers-config.yml), by group_vars or by a role via
# lookup('env', ...). In GitHub Actions the same names are repository secrets.
# Values with spaces must be quoted. Leave a value empty to use the default.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server addresses | 服务器地址 (required for the hosts you deploy to)
# -----------------------------------------------------------------------------
# One variable per host in inventories/production/servers-config.yml (env_var).
# Plain IPv4 address or resolvable hostname — no CIDR suffix.
JP_1_V4_SSH=            # jp-1    Japan      web_servers
UK_1_V4_SSH=            # uk-1    UK         web_servers, v2bx_servers
US_W_1_V4_SSH=          # us-w-1  US West    web_servers, v2board_servers
SG_1_V4_SSH=            # sg-1    Singapore  proxy_servers
HK_1_V4_SSH=            # hk-1    Hong Kong  proxy_servers
UK_2_V4_SSH=            # uk-2    UK         proxy_servers, v2bx_servers
FR_1_V4_SSH=            # fr-1    France     dev_servers, dev
PL_1_V4_SSH=            # pl-1    Poland     observability, v2board, postgres, k8s_control_plane, k8s_test

# -----------------------------------------------------------------------------
# 2. Ansible connection | Ansible 连接
# -----------------------------------------------------------------------------
ANSIBLE_USER=root                 # SSH user (fleet is managed as root over keys)
ANSIBLE_PORT=22                   # SSH port
SSH_KEY_PATH=~/.ssh/id_rsa        # private key; CI writes its own key and overrides this

# -----------------------------------------------------------------------------
# 3. Firewall whitelist | 防火墙白名单
# -----------------------------------------------------------------------------
# Extra IPs/CIDRs allowed to reach the restricted ports (9100, 9080, 9090, 3100,
# 3000, 5432). Comma separated. pl-1 (PL_1_V4_SSH) is always whitelisted.
GLOBAL_WHITELIST_IPS=             # e.g. 203.0.113.10,198.51.100.0/24

# -----------------------------------------------------------------------------
# 4. Observability | 可观测性 (group_vars/all, roles/promtail, roles/grafana)
# -----------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3000

# Grafana admin login. The grafana role refuses to run with an empty password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# TLS for the Grafana/Prometheus/Loki Nginx front-ends (roles/nginx, roles/acme_ssl)
OBSERVABILITY_SSL_ENABLED=false   # true/false
OBSERVABILITY_SSL_METHOD=acme     # acme (Let's Encrypt via Cloudflare DNS) or custom
GRAFANA_DOMAIN=                   # e.g. grafana.example.com (required when SSL is enabled)
PROMETHEUS_DOMAIN=                # e.g. prometheus.example.com
LOKI_DOMAIN=                      # e.g. loki.example.com

# Custom certificate (OBSERVABILITY_SSL_METHOD=custom / K8S_CONTROL_SSL_METHOD=custom)
# PEM, base64 encoded: tools/encode_ssl_cert.sh writes both values for you.
SSL_CERTIFICATE_PEM=
SSL_CERTIFICATE_KEY_PEM=

# ACME (Let's Encrypt) — roles/acme_ssl
ACME_EMAIL=                       # expiry notifications

# -----------------------------------------------------------------------------
# 5. Cloudflare | Cloudflare (roles/acme_ssl DNS challenge, tools/cloudflare_manager.py)
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=             # preferred: scoped API token (Zone:DNS:Edit)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL=                 # alternative: account email + Global API key
CLOUDFLARE_API_KEY=
CLOUDFLARE_BASE_DOMAIN=example.com

# -----------------------------------------------------------------------------
# 6. Kubernetes control-plane front-end | K8s 控制面板 (scripts/anixops.sh, roles/nginx)
# -----------------------------------------------------------------------------
K8S_CONTROL_SSL_ENABLED=false     # true/false
K8S_CONTROL_SSL_METHOD=acme       # acme or custom (uses SSL_CERTIFICATE_* above)
K8S_DASHBOARD_DOMAIN=k8s-dashboard.example.com
K8S_API_DOMAIN=k8s-api.example.com
K8S_METRICS_DOMAIN=k8s-metrics.example.com

# -----------------------------------------------------------------------------
# 7. V2board panel | V2board 面板 (roles/v2board, roles/postgresql — pl-1, us-w-1)
# -----------------------------------------------------------------------------
V2BOARD_DEPLOY_METHOD=docker      # docker (default) or binary
V2BOARD_DOCKER_TAG=latest
V2BOARD_BINARY_URL=               # binary method only
V2BOARD_BINARY_VERSION=latest     # binary method only
V2BOARD_ENV=development           # development for the first run (AutoMigrate), then production
V2BOARD_FRONTEND_PORT=3001
V2BOARD_API_PORT=8080
V2BOARD_GRPC_PORT=50051
V2BOARD_NODEX_PORT=18081
V2BOARD_DB_TYPE=postgres
V2BOARD_PG_HOST=localhost
V2BOARD_PG_USER=v2board
V2BOARD_PG_DATABASE=v2board
V2BOARD_PG_PASSWORD=              # required (secret)
V2BOARD_REDIS_HOST=localhost
V2BOARD_REDIS_PASSWORD=
V2BOARD_JWT_SECRET=               # required (secret)
V2BOARD_API_TOKEN=                # required (secret); also used by V2bX nodes to register
V2BOARD_ADMIN_EMAIL=
V2BOARD_ADMIN_PASSWORD=           # required (secret)

# -----------------------------------------------------------------------------
# 8. V2bX nodes | V2bX 节点 (roles/v2bx — uk-1, uk-2)
# -----------------------------------------------------------------------------
V2BX_CORE=sing                    # sing, xray or hysteria2
V2BX_BINARY_URL=                  # pinned build; empty installs the upstream "latest" release
V2BX_API_HOST=                    # panel URL reachable from the node, e.g. http://10.0.0.1:8080
V2BX_AUTO_GENERATE_AUTHKEY=true   # generate the AuthKey through the panel API (needs V2BOARD_API_TOKEN)
V2BX_AUTH_KEY=                    # manual AuthKey when auto generation is off
V2BX_AUTHKEY_EXPIRE_DAYS=1
V2BX_NODE_NAME=                   # defaults to the inventory hostname
V2BX_PROTOCOLS=                   # comma list (vmess,vless) or JSON list (["vmess","vless"]); default vmess
V2BX_CERT_MODE=self               # self, http, dns or file
V2BX_CERT_DOMAIN=
V2BX_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 9. Misc | 其他
# -----------------------------------------------------------------------------
SPEEDTEST_INSTALL_METHOD=curl     # roles/speedtest: curl or git
NOTIFICATION_WEBHOOK_URL=         # roles/lifecycle: generic webhook for deploy notifications
SLACK_WEBHOOK_URL=                # roles/lifecycle: Slack incoming webhook (optional)
