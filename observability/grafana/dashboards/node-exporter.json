          "legendFormat": "{{ instance }} {{ mountpoint }}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "description": "Linear prediction of free space in 24 hours based on the last 6 hours; below zero means the filesystem will fill."
