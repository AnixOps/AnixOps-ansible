{{ ansible_managed | comment(prefix='', postfix='') }}
# Grafana configuration | Grafana 配置
# Managed by roles/grafana; edit the role variables, not this file.

[paths]
data = {{ grafana_data_dir }}
logs = {{ grafana_log_dir }}
plugins = {{ grafana_data_dir }}/plugins
provisioning = {{ grafana_provisioning_dir }}

[server]
protocol = http
http_addr = {{ grafana_http_addr }}
http_port = {{ grafana_http_port }}
domain = {{ grafana_domain }}
root_url = {{ grafana_root_url }}
serve_from_sub_path = false
enforce_domain = false

[security]
admin_user = {{ grafana_admin_user }}
{# Triple quotes keep the password literal: unquoted, Grafana's INI parser cuts
   the value at the first # or ;, strips surrounding quotes and joins a trailing
   backslash with the next line. | 三引号保持密码原样 #}
admin_password = """{{ grafana_admin_password }}"""
cookie_secure = {{ 'true' if grafana_ssl_enabled | bool else 'false' }}
cookie_samesite = lax
disable_gravatar = true

[users]
allow_sign_up = {{ 'true' if grafana_allow_sign_up | bool else 'false' }}
auto_assign_org = true
auto_assign_org_role = Viewer
default_theme = {{ grafana_default_theme }}

[auth.anonymous]
enabled = {{ 'true' if grafana_anonymous_enabled | bool else 'false' }}

[analytics]
reporting_enabled = {{ 'true' if grafana_analytics_reporting | bool else 'false' }}
check_for_updates = {{ 'true' if grafana_check_for_updates | bool else 'false' }}
check_for_plugin_updates = {{ 'true' if grafana_check_for_updates | bool else 'false' }}

[metrics]
enabled = true

[log]
mode = console
level = {{ grafana_log_level }}

[dashboards]
versions_to_keep = 20
{% if grafana_extra_ini | length > 0 %}

{{ grafana_extra_ini }}
{% endif %}
