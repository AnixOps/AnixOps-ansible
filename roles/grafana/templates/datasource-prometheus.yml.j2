{{ ansible_managed | comment }}
# Grafana datasource provisioning: Prometheus
---
apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: {{ grafana_prometheus_url }}
    isDefault: true
    editable: false
    jsonData:
      timeInterval: {{ grafana_prometheus_scrape_interval }}
      httpMethod: POST
