# =============================================================================
# PostgreSQL client authentication | PostgreSQL 客户端认证配置
# Managed by Ansible (role: postgresql) - do not edit manually.
# 由 Ansible 管理，请勿手动编辑。
# =============================================================================
# Rules are evaluated top to bottom, first match wins.
#
# TYPE  DATABASE        USER            ADDRESS                 METHOD

# Application role over the local Unix socket (password, scram-sha-256)
local   {{ postgresql_database }}   {{ postgresql_user }}   scram-sha-256

# Local administration (peer: the OS user must match the database role)
local   all             postgres                                peer
local   all             all                                     peer

# Application role from allowed networks | 允许访问的网络
{% for cidr in postgresql_allowed_cidrs %}
host    {{ postgresql_database }}   {{ postgresql_user }}   {{ cidr }}   scram-sha-256
{% endfor %}
{% if postgresql_extra_hba_rules | length > 0 %}

# Operator supplied rules (postgresql_extra_hba_rules) | 额外规则
{% for rule in postgresql_extra_hba_rules %}
{{ rule }}
{% endfor %}
{% endif %}

# Everything else is rejected | 拒绝其他所有连接
host    all             all             0.0.0.0/0               reject
host    all             all             ::/0                    reject
