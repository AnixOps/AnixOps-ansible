{{ ansible_managed | comment }}
# Loki single-binary configuration, filesystem storage | Loki 单机配置
# Managed by roles/loki; edit the role variables, not this file.
---
auth_enabled: false

server:
  http_listen_address: {{ loki_listen_address }}
  http_listen_port: {{ loki_port }}
  grpc_listen_address: {{ loki_listen_address }}
  grpc_listen_port: {{ loki_grpc_port }}
  log_level: {{ loki_log_level }}

common:
  path_prefix: {{ loki_data_dir }}
  storage:
    filesystem:
      chunks_directory: {{ loki_data_dir }}/chunks
      rules_directory: {{ loki_data_dir }}/rules
  replication_factor: 1
  ring:
    instance_addr: 127.0.0.1
    kvstore:
      store: inmemory

# Index/chunk schema. Periods are append-only: to migrate to TSDB add a new
# entry with a FUTURE `from` date via loki_schema_configs, e.g.
#   - from: "2026-12-01"
#     store: tsdb
#     object_store: filesystem
#     schema: v13
#     index: {prefix: tsdb_index_, period: 24h}
schema_config:
  configs:
{% for schema in loki_schema_configs %}
    - from: {{ schema.from | string | to_json }}
      store: {{ schema.store }}
      object_store: {{ schema.object_store }}
      schema: {{ schema.schema }}
      index:
        prefix: {{ schema.index.prefix }}
        period: {{ schema.index.period }}
{% endfor %}

# Retention is applied by the compactor; the working directory lives under
# {{ loki_data_dir }} so it is covered by the unit's ReadWritePaths.
compactor:
  working_directory: {{ loki_data_dir }}/compactor
{% if loki_version is version('3.0.0', '<') %}
  shared_store: filesystem
{% else %}
  delete_request_store: filesystem
{% endif %}
  compaction_interval: {{ loki_compaction_interval }}
  retention_enabled: {{ loki_retention_enabled | bool | lower }}
{% if loki_retention_enabled | bool %}
  retention_delete_delay: {{ loki_retention_delete_delay }}
  retention_delete_worker_count: 150
{% endif %}

limits_config:
{% if loki_retention_enabled | bool %}
  retention_period: {{ loki_retention_period }}
{% endif %}
  reject_old_samples: {{ loki_reject_old_samples | bool | lower }}
  reject_old_samples_max_age: {{ loki_reject_old_samples_max_age }}
  ingestion_rate_mb: {{ loki_ingestion_rate_mb }}
  ingestion_burst_size_mb: {{ loki_ingestion_burst_size_mb }}
  max_query_series: {{ loki_max_query_series }}
{% if loki_version is version('3.0.0', '>=') and loki_schema_configs | map(attribute='schema') | select('in', ['v11', 'v12']) | list | length > 0 %}
  # Structured metadata requires schema v13; disabled while v11/v12 periods exist.
  allow_structured_metadata: false
{% endif %}
{% if loki_alertmanager_url | length > 0 %}

ruler:
  alertmanager_url: {{ loki_alertmanager_url }}
{% endif %}

analytics:
  reporting_enabled: false
