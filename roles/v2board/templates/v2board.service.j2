# Managed by Ansible (role: v2board) - do not edit manually.
[Unit]
Description=V2board Control Panel
Documentation=https://github.com/{{ v2board_repo_owner }}/{{ v2board_repo_name }}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ v2board_service_user }}
Group={{ v2board_service_group }}
WorkingDirectory={{ v2board_data_dir }}
ExecStart={{ v2board_install_dir }}/{{ v2board_bin_name }} -config {{ v2board_config_dir }}/config.yaml
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
{% if v2board_systemd_log_files | bool %}
StandardOutput=append:{{ v2board_data_dir }}/logs/v2board.log
StandardError=append:{{ v2board_data_dir }}/logs/v2board-error.log
{% endif %}

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths={{ v2board_data_dir }}

[Install]
WantedBy=multi-user.target
