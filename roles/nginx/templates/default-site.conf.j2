# {{ ansible_managed }}
# Catch-all default site generated by the AnixOps nginx role.
server {
    listen {{ nginx_port }} default_server;
{% if nginx_default_site_ipv6 | bool %}
    listen [::]:{{ nginx_port }} default_server;
{% endif %}

    server_name _;
    root {{ nginx_web_root }};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

    # Health check endpoint used by the role, the lifecycle hooks and monitoring
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    # Nginx status for monitoring (loopback only)
    location = /nginx_status {
        stub_status on;
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
