# {{ ansible_managed }}
# Security response headers applied in the http context.
# nginx does not inherit add_header into a server/location block that defines
# its own add_header directives; repeat the headers there when needed.
{% for header_name, header_value in nginx_security_headers.items() %}
add_header {{ header_name }} "{{ header_value }}" always;
{% endfor %}
{% if nginx_hsts_enabled | bool %}
add_header Strict-Transport-Security "{{ nginx_hsts_header }}" always;
{% endif %}
