# {{ ansible_managed }}
{{ nginx_log_dir }}/*.log {
    daily
    missingok
    rotate {{ nginx_log_rotate_days }}
    compress
    delaycompress
    notifempty
    create 0640 {{ nginx_user }} {{ nginx_log_group }}
    sharedscripts
    postrotate
        if [ -f {{ nginx_pid_file }} ]; then
            kill -USR1 "$(cat {{ nginx_pid_file }})"
        fi
    endscript
}
