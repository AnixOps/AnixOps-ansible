# {{ ansible_managed }}
# Virtual host "{{ item.name }}" generated by the AnixOps nginx role.
server {
    listen {{ item.listen | default(80) }}{% if item.ssl is defined %} ssl{% endif %}{% if item.http2 | default(false) %} http2{% endif %}{% if item.default_server | default(false) %} default_server{% endif %};
{% if item.listen_ipv6 | default(false) %}
    listen [::]:{{ item.listen | default(80) }}{% if item.ssl is defined %} ssl{% endif %}{% if item.http2 | default(false) %} http2{% endif %}{% if item.default_server | default(false) %} default_server{% endif %};
{% endif %}
{% for extra_listen in item.extra_listen | default([]) %}
    listen {{ extra_listen }};
{% endfor %}

    server_name {{ item.server_name | default('_') }};
{% if item.root is defined %}
    root {{ item.root }};
{% endif %}
{% if item.index is defined %}
    index {{ item.index }};
{% endif %}
{% if item.client_max_body_size is defined %}
    client_max_body_size {{ item.client_max_body_size }};
{% endif %}
{% if item.ssl is defined %}

    # TLS (protocols/ciphers fall back to the http-level defaults in nginx.conf)
    ssl_certificate {{ item.ssl.cert }};
    ssl_certificate_key {{ item.ssl.key }};
{% if item.ssl.protocols is defined %}
    ssl_protocols {{ item.ssl.protocols }};
{% endif %}
{% if item.ssl.ciphers is defined %}
    ssl_ciphers {{ item.ssl.ciphers }};
{% endif %}
{% endif %}
{% if item.custom_head | default('') | trim | length > 0 %}

    # Custom directives (custom_head)
    {{ item.custom_head | trim | indent(4) }}
{% endif %}
{% for location in item.locations | default([]) %}

    location {{ location.path }} {
{% if location.root is defined %}
        root {{ location.root }};
{% endif %}
{% if location.alias is defined %}
        alias {{ location.alias }};
{% endif %}
{% if location.try_files is defined %}
        try_files {{ location.try_files }};
{% endif %}
{% if location.proxy_pass is defined %}
        proxy_pass {{ location.proxy_pass }};
        include /etc/nginx/proxy_params;
{% endif %}
{% if location.return is defined %}
        return {{ location.return }};
{% endif %}
{% if location.custom_content | default('') | trim | length > 0 %}
        {{ location.custom_content | trim | indent(8) }}
{% endif %}
    }
{% endfor %}
{% if item.locations is not defined and item.root is defined %}

    location / {
        try_files $uri $uri/ =404;
    }
{% endif %}
{% if item.custom_tail | default('') | trim | length > 0 %}

    # Custom directives (custom_tail)
    {{ item.custom_tail | trim | indent(4) }}
{% endif %}

    access_log {{ item.access_log | default(nginx_log_dir ~ '/' ~ item.name ~ '.access.log') }};
    error_log {{ item.error_log | default(nginx_log_dir ~ '/' ~ item.name ~ '.error.log') }};
}
