# {{ ansible_managed }}
# Managed by the AnixOps nginx role - local edits are overwritten on the next run.
user {{ nginx_user }};
worker_processes {{ nginx_worker_processes }};
pid {{ nginx_pid_file }};
{% if nginx_modules_include | default('') | length > 0 %}
include {{ nginx_modules_include }};
{% endif %}

events {
    worker_connections {{ nginx_worker_connections }};
    use epoll;
    multi_accept on;
}

http {
    ##
    # Basic Settings
    ##
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout {{ nginx_keepalive_timeout }};
    types_hash_max_size {{ nginx_types_hash_max_size }};
    server_names_hash_bucket_size {{ nginx_server_names_hash_bucket_size }};
    server_tokens {{ nginx_server_tokens }};

    client_max_body_size {{ nginx_client_max_body_size }};
    client_body_buffer_size 128k;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    ##
    # SSL Settings
    ##
    ssl_protocols {{ nginx_ssl_protocols }};
    ssl_prefer_server_ciphers {{ nginx_ssl_prefer_server_ciphers }};
    ssl_ciphers '{{ nginx_ssl_ciphers }}';
    ssl_session_cache {{ nginx_ssl_session_cache }};
    ssl_session_timeout {{ nginx_ssl_session_timeout }};
    ssl_session_tickets {{ nginx_ssl_session_tickets }};

    ##
    # Logging Settings
    ##
    log_format main '{{ nginx_log_format }}';
    access_log {{ nginx_log_dir }}/access.log main;
    error_log {{ nginx_log_dir }}/error.log {{ nginx_error_log_level }};

    ##
    # Gzip Settings
    ##
    gzip {{ 'on' if nginx_gzip_enabled | bool else 'off' }};
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;
    gzip_disable "msie6";
{% if nginx_extra_http_configs | default('') | trim | length > 0 %}

    ##
    # Extra http-level configuration (nginx_extra_http_configs)
    ##
    {{ nginx_extra_http_configs | trim | indent(4) }}
{% endif %}

    ##
    # Virtual Host Configs
    ##
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
