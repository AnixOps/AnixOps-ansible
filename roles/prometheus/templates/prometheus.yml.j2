{{ ansible_managed | comment }}
# Prometheus server configuration | Prometheus 服务端配置
# Managed by roles/prometheus; edit the inventory / role variables, not this file.
---
{#- Relabelling shared by every job: keep the scraped address in `target_ip`
    and expose the friendly alias as `instance` (applies to `up` as well). -#}
{% macro alias_relabel() %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: target_ip
      - source_labels: [alias]
        target_label: instance
{% endmacro %}
{% set prometheus_self_alias = server_alias | default(inventory_hostname) | string %}
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  scrape_timeout: {{ prometheus_scrape_timeout }}
  evaluation_interval: {{ prometheus_evaluation_interval }}
{% if prometheus_external_labels | length > 0 %}
  external_labels:
{%   for label_name, label_value in prometheus_external_labels.items() %}
    {{ label_name }}: {{ label_value | string | to_json }}
{%   endfor %}
{% endif %}

{% if prometheus_alertmanager_targets | length > 0 %}
alerting:
  alertmanagers:
    - static_configs:
        - targets: {{ prometheus_alertmanager_targets | to_json }}

{% endif %}
rule_files:
  - {{ (prometheus_rules_dir ~ '/*.yml') | to_json }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:{{ prometheus_port }}']
        labels:
          alias: {{ prometheus_self_alias | to_json(ensure_ascii=False) }}
{{ alias_relabel() -}}

{# ---------------------------------------------------------------------------
   node_exporter: one target per inventory host.
   - skipped: hosts whose ansible_host renders empty (e.g. unset env var), hosts
     with prometheus_scrape_enabled: false, and duplicate addresses (several
     inventory names for one machine). Priority on duplicates: this host first,
     then hosts that define server_alias, then the rest (all sorted).
   - hosts without ansible_host are scraped by inventory name.
   --------------------------------------------------------------------------- #}
{% set prometheus_group_hosts = groups[prometheus_node_exporter_group] | default([]) | sort %}
{% set prometheus_ordered_hosts = ([inventory_hostname] if inventory_hostname in prometheus_group_hosts else [])
     + (prometheus_group_hosts | select('ne', inventory_hostname) | select('in', hostvars | dict2items | selectattr('value.server_alias', 'defined') | map(attribute='key') | list) | list)
     + (prometheus_group_hosts | select('ne', inventory_hostname) | reject('in', hostvars | dict2items | selectattr('value.server_alias', 'defined') | map(attribute='key') | list) | list) %}
{% set prometheus_ns = namespace(seen=[]) %}
  - job_name: node_exporter
    static_configs:
{% for host in prometheus_ordered_hosts %}
{%   set host_address = (hostvars[host]['ansible_host'] if hostvars[host]['ansible_host'] is defined else host) | string | trim %}
{%   if host_address | length > 0
        and host_address not in prometheus_ns.seen
        and (hostvars[host]['prometheus_scrape_enabled'] | default(true) | bool) %}
{%     set prometheus_ns.seen = prometheus_ns.seen + [host_address] %}
      - targets:
          - {{ (host_address ~ ':' ~ prometheus_node_exporter_port) | to_json }}
        labels:
          alias: {{ hostvars[host]['server_alias'] | default(host) | string | to_json(ensure_ascii=False) }}
          location: {{ hostvars[host]['location'] | default('unknown') | string | to_json(ensure_ascii=False) }}
          environment: {{ hostvars[host]['server_environment'] | default('unknown') | string | to_json(ensure_ascii=False) }}
          description: {{ hostvars[host]['description'] | default('') | string | to_json(ensure_ascii=False) }}
          inventory_host: {{ host | to_json }}
{%   endif %}
{% endfor %}
{{ alias_relabel() -}}
    metric_relabel_configs:
      - regex: 'server|hostname'
        action: labeldrop
{% if prometheus_scrape_promtail | bool %}

  - job_name: promtail
    static_configs:
      - targets: ['localhost:{{ prometheus_promtail_port }}']
        labels:
          alias: {{ prometheus_self_alias | to_json(ensure_ascii=False) }}
{{ alias_relabel() -}}
{% endif %}
{% if prometheus_scrape_loki | bool %}

  - job_name: loki
    static_configs:
      - targets: ['localhost:{{ prometheus_loki_port }}']
        labels:
          alias: {{ prometheus_self_alias | to_json(ensure_ascii=False) }}
{{ alias_relabel() -}}
{% endif %}
{% if prometheus_scrape_grafana | bool %}

  - job_name: grafana
    static_configs:
      - targets: ['localhost:{{ prometheus_grafana_port }}']
        labels:
          alias: {{ prometheus_self_alias | to_json(ensure_ascii=False) }}
{{ alias_relabel() -}}
{% endif %}
{% if prometheus_speedtest_exporter_host | string | length > 0 %}

  - job_name: speedtest
    honor_labels: true
    scrape_interval: {{ prometheus_speedtest_scrape_interval }}
    scrape_timeout: {{ prometheus_speedtest_scrape_timeout }}
    static_configs:
      - targets:
          - {{ (prometheus_speedtest_exporter_host ~ ':' ~ prometheus_speedtest_exporter_port) | to_json }}
{% endif %}
{% if prometheus_extra_scrape_configs | length > 0 %}

  # Extra scrape configs (prometheus_extra_scrape_configs)
  {{ prometheus_extra_scrape_configs | to_nice_yaml(indent=2, width=1000) | indent(2) | trim }}
{% endif %}
