# =============================================================================
# Fail2Ban jail overrides - managed by Ansible (roles/common)
# Read after jail.conf and jail.d/*.conf; local edits are overwritten.
# =============================================================================

[DEFAULT]
ignoreip = {{ common_fail2ban_ignore_ips | join(' ') }}
bantime = {{ common_fail2ban_ban_time }}
findtime = {{ common_fail2ban_find_time }}
maxretry = {{ common_fail2ban_max_retry }}
# journald backend: no dependency on rsyslog / /var/log/auth.log
backend = {{ common_fail2ban_backend }}
{% if common_fail2ban_banaction | length > 0 %}
banaction = {{ common_fail2ban_banaction }}
banaction_allports = {{ common_fail2ban_banaction }}
{% endif %}
destemail = {{ common_fail2ban_dest_email }}
sendername = Fail2Ban
action = %(action_)s

[sshd]
enabled = true
port = {{ common_ssh_port }}
maxretry = {{ common_fail2ban_max_retry }}
{% if common_fail2ban_extra_jails | length > 0 %}

{{ common_fail2ban_extra_jails }}
{% endif %}
