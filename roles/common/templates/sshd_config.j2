# =============================================================================
# OpenSSH server configuration - managed by Ansible (roles/common)
# Local edits are overwritten on the next run.
# Drop-ins under /etc/ssh/sshd_config.d are intentionally NOT included: on
# Ubuntu cloud images they re-enable password authentication (see README).
# =============================================================================

# --- Network -----------------------------------------------------------------
Port {{ common_ssh_port }}
AddressFamily {{ common_ssh_address_family }}
{% for address in common_ssh_listen_addresses %}
ListenAddress {{ address }}
{% endfor %}

# --- Authentication ----------------------------------------------------------
PermitRootLogin {{ 'yes' if common_ssh_allow_root | bool else 'prohibit-password' }}
PubkeyAuthentication {{ 'yes' if common_ssh_pubkey_authentication | bool else 'no' }}
PasswordAuthentication {{ 'yes' if common_ssh_password_authentication | bool else 'no' }}
PermitEmptyPasswords no
ChallengeResponseAuthentication no
UsePAM yes
HostbasedAuthentication no
IgnoreRhosts yes
PermitUserEnvironment no
{% if common_ssh_allow_users | length > 0 %}
AllowUsers {{ common_ssh_allow_users | join(' ') }}
{% endif %}
{% if common_ssh_allow_groups | length > 0 %}
AllowGroups {{ common_ssh_allow_groups | join(' ') }}
{% endif %}

# --- Brute-force and resource limits -----------------------------------------
StrictModes yes
LoginGraceTime {{ common_ssh_login_grace_time }}
MaxAuthTries {{ common_ssh_max_auth_tries }}
MaxSessions {{ common_ssh_max_sessions }}
MaxStartups {{ common_ssh_max_startups }}

# --- Cryptography ------------------------------------------------------------
KexAlgorithms {{ common_ssh_kex_algorithms | join(',') }}
Ciphers {{ common_ssh_ciphers | join(',') }}
MACs {{ common_ssh_macs | join(',') }}

# --- Logging -----------------------------------------------------------------
SyslogFacility AUTH
LogLevel {{ common_ssh_log_level }}

# --- Sessions ----------------------------------------------------------------
ClientAliveInterval {{ common_ssh_client_alive_interval }}
ClientAliveCountMax {{ common_ssh_client_alive_count_max }}
TCPKeepAlive yes
UseDNS {{ 'yes' if common_ssh_use_dns | bool else 'no' }}
AcceptEnv LANG LC_*

# --- Forwarding --------------------------------------------------------------
AllowTcpForwarding {{ 'yes' if common_ssh_allow_tcp_forwarding | bool else 'no' }}
AllowAgentForwarding {{ 'yes' if common_ssh_allow_agent_forwarding | bool else 'no' }}
X11Forwarding {{ 'yes' if common_ssh_x11_forwarding | bool else 'no' }}
GatewayPorts no
PermitTunnel no
PrintMotd no
PrintLastLog yes

# --- Subsystems --------------------------------------------------------------
Subsystem sftp {{ common_ssh_sftp_server_path }}

# --- Banner ------------------------------------------------------------------
Banner {{ common_ssh_banner }}
{% if common_ssh_extra_config | length > 0 %}

# --- Extra options (common_ssh_extra_config) ---------------------------------
{{ common_ssh_extra_config }}
{% endif %}
