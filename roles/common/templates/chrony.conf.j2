# =============================================================================
# Chrony NTP configuration - managed by Ansible (roles/common)
# Local edits are overwritten on the next run.
# =============================================================================

# Time sources | 时间源
{% for server in common_ntp_servers %}
server {{ server }} iburst
{% endfor %}
{% for pool in common_ntp_pools %}
pool {{ pool }} iburst
{% endfor %}

# Record the rate at which the system clock gains/loses time | 记录时钟漂移
driftfile /var/lib/chrony/drift

# Step the clock during the first updates if the offset is large | 大偏差时跳变
makestep {{ common_chrony_makestep }}

# Keep the hardware clock (RTC) in sync | 同步硬件时钟
rtcsync

# Log directory | 日志目录
logdir /var/log/chrony
{% if common_chrony_extra_config | length > 0 %}

# Extra options (common_chrony_extra_config) | 额外选项
{{ common_chrony_extra_config }}
{% endif %}
