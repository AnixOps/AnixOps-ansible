# Managed by Ansible (role: node_exporter). Local changes will be overwritten.
{% set _listen = node_exporter_listen_address | default('') | string %}
{% if ':' in _listen and not _listen.startswith('[') %}
{%   set _listen = '[' ~ _listen ~ ']' %}
{% endif %}
[Unit]
Description=Prometheus Node Exporter
Documentation=https://github.com/prometheus/node_exporter
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ node_exporter_user }}
Group={{ node_exporter_group }}
ExecStart={{ node_exporter_install_path }} \
    --web.listen-address={{ _listen }}:{{ node_exporter_port }}{% for arg in (node_exporter_collector_args + node_exporter_extra_args) %} \
    {{ arg }}{% endfor %}


SyslogIdentifier=node_exporter
Restart=on-failure
RestartSec=5s

# Hardening: node_exporter only reads /proc and /sys and writes nothing.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
