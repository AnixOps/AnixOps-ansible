# Managed by Ansible (role: promtail). Local changes will be overwritten.
[Unit]
Description=Promtail log shipping agent for Grafana Loki
Documentation=https://grafana.com/docs/loki/latest/send-data/promtail/
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ promtail_user }}
Group={{ promtail_group }}
ExecStart={{ promtail_install_path }} \
    -config.file={{ promtail_config_path }}{% for arg in promtail_extra_args %} \
    {{ arg }}{% endfor %}


SyslogIdentifier=promtail
Restart=on-failure
RestartSec=5s

# Hardening: the filesystem is read-only except the positions directory.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ promtail_positions_dir }}
ProtectHome={{ 'true' if promtail_unit_protect_home | bool else 'false' }}
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
