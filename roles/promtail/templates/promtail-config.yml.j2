# Managed by Ansible (role: promtail). Local changes will be overwritten.
{% set _scrape_configs = promtail_scrape_configs
     + ([promtail_journal_scrape_config] if promtail_journal_enabled | bool else [])
     + promtail_extra_scrape_configs %}
server:
{% if promtail_listen_address | default('') | length > 0 %}
  http_listen_address: {{ promtail_listen_address }}
{% endif %}
  http_listen_port: {{ promtail_port }}
  grpc_listen_port: 0
  log_level: {{ promtail_log_level }}

positions:
  filename: {{ promtail_positions_file }}

clients:
  - url: {{ promtail_loki_url | regex_replace('/+$', '') }}/loki/api/v1/push
{% if promtail_loki_tenant_id | length > 0 %}
    tenant_id: {{ promtail_loki_tenant_id | to_json }}
{% endif %}
{% if promtail_loki_basic_auth_username | length > 0 %}
    basic_auth:
      username: {{ promtail_loki_basic_auth_username | to_json }}
      password: {{ promtail_loki_basic_auth_password | to_json }}
{% endif %}
    batchwait: {{ promtail_client_batchwait }}
    batchsize: {{ promtail_client_batchsize }}
    timeout: {{ promtail_client_timeout }}
    backoff_config:
      min_period: {{ promtail_client_backoff_min_period }}
      max_period: {{ promtail_client_backoff_max_period }}
      max_retries: {{ promtail_client_backoff_max_retries }}
{% set _ext_labels = promtail_external_labels | dict2items | rejectattr('value', 'none') | rejectattr('value', 'equalto', '') | list %}
{% if _ext_labels | length > 0 %}
    external_labels:
{% for item in _ext_labels %}
      {{ item.key }}: {{ item.value | string | to_json }}
{% endfor %}
{% endif %}

scrape_configs:
{{ _scrape_configs | to_nice_yaml(indent=2, sort_keys=false) | indent(2, first=true) }}
