{# Managed by Ansible (role: v2bx) - do not edit manually. #}
{
  "Log": {
    "Level": {{ v2bx_log_level | to_json }},
    "Output": ""
  },
  "Cores": [
    {
      "Type": {{ v2bx_core | to_json }},
      "Name": {{ (v2bx_core ~ '_core') | to_json }},
      "Log": {
        "Level": {{ v2bx_log_level | to_json }},
        "Timestamp": true
      },
      "NTP": {
        "Enable": false,
        "Server": "time.apple.com",
        "ServerPort": 0
      }
    }
  ],
  "Nodes": [
{% for protocol in v2bx_protocols %}
    {
      "Name": {{ (v2bx_node_name ~ '-' ~ protocol) | to_json }},
      "Core": {{ (v2bx_core ~ '_core') | to_json }},
      "ApiHost": {{ v2bx_api_host | to_json }},
      "AutoRegister": {{ v2bx_auto_register | bool | to_json }},
      "AuthKey": {{ v2bx_auth_key | to_json }},
      "NodeName": {{ v2bx_node_name | to_json }},
      "NodeType": {{ protocol | to_json }},
      "CredentialFile": {{ v2bx_credential_file | to_json }},
      "HeartbeatInterval": {{ v2bx_heartbeat_interval | int }},
      "EnableSign": {{ v2bx_enable_sign | bool | to_json }},
      "EncryptCredential": {{ v2bx_encrypt_credential | bool | to_json }},
      "Timeout": 30,
      "ListenIP": "0.0.0.0",
      "SendIP": "0.0.0.0",
      "DeviceOnlineMinTraffic": 200,
      "MinReportTraffic": 0,
      "TCPFastOpen": false,
      "SniffEnabled": true,
      "CertConfig": {
        "CertMode": {{ v2bx_cert_mode | to_json }},
        "RejectUnknownSni": false,
        "CertDomain": {{ v2bx_cert_domain | to_json }},
        "CertFile": "",
        "KeyFile": "",
        "Provider": "cloudflare"
      }
    }{% if not loop.last %},{% endif %}

{% endfor %}
  ]
}
