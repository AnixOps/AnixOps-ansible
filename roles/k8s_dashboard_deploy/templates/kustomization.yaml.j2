# {{ ansible_managed }}
# Applies the pinned upstream manifest plus the admin service account. Upstream ships the
# kubernetes-dashboard-csrf Secret with data.csrf "", and re-applying that would blank the key the
# dashboard generated at start-up (and report "configured"). The Secret object is kept, because the
# dashboard needs it to exist, but its data is left to the dashboard.
# 保留 kubernetes-dashboard-csrf Secret 对象，但不下发其 data，避免每次 apply 清空 CSRF 密钥。
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - recommended-{{ k8s_dashboard_deploy_version }}.yaml
  - admin-user.yaml
patches:
  - target:
      kind: Secret
      name: kubernetes-dashboard-csrf
    patch: |-
      - op: remove
        path: /data
