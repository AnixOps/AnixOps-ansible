# {{ ansible_managed }}
[Unit]
Description=kubectl port-forward for the Kubernetes Dashboard
After=network-online.target {{ k8s_dashboard_deploy_k3s_service_name }}.service
Wants=network-online.target
Requires={{ k8s_dashboard_deploy_k3s_service_name }}.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
ExecStart={{ k8s_dashboard_deploy_kubectl_bin }} \
  --kubeconfig={{ k8s_dashboard_deploy_kubeconfig_path }} \
  --cache-dir=/var/cache/{{ k8s_dashboard_deploy_service_name }} \
  --namespace={{ k8s_dashboard_deploy_namespace }} \
  port-forward --address={{ k8s_dashboard_deploy_bind_address }} \
  service/kubernetes-dashboard {{ k8s_dashboard_deploy_port }}:443
# port-forward exits cleanly when the backing pod is replaced; restart unconditionally so the
# proxy follows the pod.
Restart=always
RestartSec=5s
CacheDirectory={{ k8s_dashboard_deploy_service_name }}
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
