{#- Every value is double-quoted for the compose-go dotenv parser (`--env-file`):
    null renders empty and surrounding whitespace is trimmed (as unquoted values were),
    then backslash is escaped first, then the double quote, then `$` as `$$` so secrets
    are never cut at " #", interpolated or mangled. -#}
{%- macro dq(v) -%}
"{{ ('' if v is none else v) | string | trim | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '$$') }}"
{%- endmacro -%}
