---
# ansible-lint configuration — strict "production" profile.
# https://ansible.readthedocs.io/projects/lint/configuring/
profile: production

exclude_paths:
  - .ansible/
  - .cache/
  - .git/
  - .github/
  - collections/
  - venv/
  - .venv/
  - observability/
  - tests/fixtures/

kinds:
  - playbook: "playbooks/**/*.yml"
  - playbook: "tests/integration/*.yml"
  - tasks: "playbooks/maintenance/security-patch/*.yml"
  - tasks: "roles/*/tasks/**/*.yml"
  - vars: "inventories/**/group_vars/**/*.yml"
  - vars: "inventories/**/host_vars/**/*.yml"

# Nothing is skipped: every rule in the production profile must pass.
skip_list: []

# Informational only.
warn_list:
  - experimental
  - yaml[line-length]
